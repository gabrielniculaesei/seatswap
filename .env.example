# Copy to .env and fill in. Never commit .env.

# --- database -----------------------------------------------------------------
# Neon in production, the docker-compose postgres locally.
DATABASE_URL=postgres://seatswap:seatswap@localhost:5432/seatswap
# Optional. The solver's database tests run against this instead of DATABASE_URL,
# so they can never be pointed at anything real by accident. They TRUNCATE.
# TEST_DATABASE_URL=postgres://seatswap:seatswap@localhost:5432/seatswap_test

# --- telegram -----------------------------------------------------------------
# From @BotFather. The bot token doubles as the key for verifying the
# Login Widget HMAC, so it is the single most sensitive value here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random string sent as X-Telegram-Bot-Api-Secret-Token on the webhook.
TELEGRAM_WEBHOOK_SECRET=

# --- sessions -----------------------------------------------------------------
# 32+ random bytes. Signs the httpOnly session cookie.
SESSION_SECRET=

# --- external apis ------------------------------------------------------------
# AeroDataBox via RapidAPI. One call per flight, never per user.
RAPIDAPI_KEY=
# 'fixture' in dev and in tests; 'live' in production once RAPIDAPI_KEY is set.
# 'off' (also the default when unset) makes no calls: flights stay unverified and
# their times are estimated from the date, which is how to launch without a key.
# RapidAPI's free Basic plan is 400 units/month at 2 units a flight, about 200
# new flights a month, and is for non-commercial use only.
AERODATABOX_MODE=fixture

# --- app ----------------------------------------------------------------------
# The public origin, no trailing slash. Load-bearing for more than links: every
# canonical URL, the sitemap and robots.txt are built from it, so a wrong value
# here quietly points search engines at the wrong host.
PUBLIC_BASE_URL=http://localhost:3000

# Who runs the site, named on /privacy and /terms. GDPR requires the privacy
# policy to name the data controller and give a way to reach them; unset, both
# pages show a visible "[... not set]" placeholder instead.
OPERATOR_NAME=
CONTACT_EMAIL=

# --- worker -------------------------------------------------------------------
LOG_LEVEL=INFO

# How many brand-new flights one Telegram account may add per day. Creating a
# flight is the only visitor action that spends an AeroDataBox call, so it is
# metered; joining a flight that already exists is free and unmetered. 0 stops
# new flights entirely without taking the site down. Unset means the default (5).
MAX_NEW_FLIGHTS_PER_DAY=5

# --- solver -------------------------------------------------------------------
# Minimum utility a party must gain to be worth moving at all, in preference
# points (a window seat is worth 60, a must-have adjacency 200).
MIN_GAIN=20
SOLVER_MAX_SECONDS=10
